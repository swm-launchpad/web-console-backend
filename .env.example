# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password-here
DB_NAME=web_console

# Server Configuration
PORT=8080
GIN_MODE=release

# JWT Configuration
JWT_SECRET=your-jwt-secret-here

# CORS Configuration (comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://example.com

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here
EMAIL_FROM=your-email@gmail.com

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Backend Configuration
BACKEND_URL=http://localhost:8080

# GitHub App Configuration (Optional - for private repository access)
# Leave empty to disable GitHub integration
# Get these values from GitHub App settings: https://github.com/settings/apps/your-app
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app-private-key.pem
GITHUB_APP_INSTALLATION_URL=https://github.com/apps/your-app-name/installations/new

# GitHub App Installation ID for private repositories
# Used only in tests, not needed in production
GITHUB_APP_INSTALLATION_ID=your-github-app-installation-id

# Kubernetes Configuration
KUBE_API_SERVER=https://kube-api.launchpad.kr:6443
KUBE_SERVICE_ACCOUNT_TOKEN=your-serviceaccount-token-here
KUBE_DEPLOY_NAMESPACE=deploy-pipeline
KUBE_BUILD_NAMESPACE=build-pipeline

# TLS Configuration (REQUIRED)
# Path to Kubernetes cluster CA certificate for secure TLS verification
# See docs/KUBE_CA_SETUP.md for instructions on how to obtain the CA certificate
KUBE_CA_CERT_PATH=/etc/kube/ca.crt

# Tekton Configuration
TEKTON_DEPLOY_URL=https://tekton-api.launchpad.kr/deploy
TEKTON_BUILD_URL=https://tekton-api.launchpad.kr/build
TEKTON_API_AUTH=Basic your-basic-auth-here

# Container Registry Configuration
REGISTRY_URL=957833999474.dkr.ecr.ap-northeast-2.amazonaws.com

# Loki Configuration (for build log streaming)
LOKI_URL=https://loki.launchpad.kr
LOKI_USERNAME=loki-user
LOKI_PASSWORD=your-loki-password-here
LOKI_ORG_ID=1
